{
  "name": "agentic-asset-example",
  "version": "0.0.1",
  "description": "Reference agentic asset: the twin of a delivery vehicle that diagnoses its own faults and procures its own service under a constitution it does not control.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ixo/oracle-runtime": "workspace:*",
    "@nestjs/common": "^11.1.19",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@ixo/vitest-config": "workspace:*",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
