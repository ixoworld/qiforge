# Copy to .dev.vars for `wrangler dev`. Everything here is a secret or
# environment-specific; non-secret defaults live in wrangler.jsonc `vars`.

# --- identity ---------------------------------------------------------------
ORACLE_DID=did:ixo:ixo1oracleexample
# The oracle's real domain entity (did:ixo:entity: followed by 32 lower-case
# hex characters). The memory plugin refuses to boot without a well-formed one;
# this placeholder only has the right shape.
ORACLE_ENTITY_DID=did:ixo:entity:00000000000000000000000000000000
# Ed25519 mnemonic the oracle signs downstream UCAN invocations with (optional:
# when unset it is read from the Matrix account room the way the Node runtime
# stores it — needs MATRIX_ACCOUNT_ROOM_ID + MATRIX_VALUE_PIN below)
# ORACLE_SIGNING_MNEMONIC=

# --- auth: did:ixo key resolution ------------------------------------------
BLOCKSYNC_GRAPHQL_URL=http://localhost:34582/graphql
# Requests must carry a UCAN invocation; `true` lets a bare x-ucan-delegation
# authenticate instead (legacy clients only, logged per request).
# UCAN_ALLOW_BARE_DELEGATION_AUTH=false

# --- matrix -----------------------------------------------------------------
MATRIX_BASE_URL=http://localhost:34008
MATRIX_HOMESERVER_NAME=ixo.test
MATRIX_ORACLE_ADMIN_USER_ID=@oracle-example:ixo.test
# The bot's password: the gateway logs its own devices in with it (no access token).
MATRIX_ORACLE_ADMIN_PASSWORD=
# MATRIX_RECOVERY_PHRASE=

# --- llm --------------------------------------------------------------------
OPEN_ROUTER_API_KEY=
# DEFAULT_MODEL=openai/gpt-6-luna
# LangGraph steps a single turn may take before GraphRecursionError (default
# 600, three times the Node runtime's 200; a tool-call round trip costs ~6
# steps with the bundled middlewares, so 600 is roughly 100 chained tool calls)
# TURN_RECURSION_LIMIT=600
# Bounded semantic Decisions (unset = off). openrouter-jev reuses OPEN_ROUTER_API_KEY;
# cloudflare-jev uses the AI binding from wrangler.jsonc instead of account credentials.
# DECISION_PROVIDER=openrouter-jev
# DECISION_MODEL=typesafe/jev-1.13
# Capability router (needs DECISION_PROVIDER): shadow logs which on-demand plugin
# it would preload per turn without acting; on preloads it for that turn.
# CAPABILITY_ROUTER=shadow

# Turn budget (docs/plans/workers-harness-hardening.md): tool attempts and the
# wall-clock deadline of one turn, shared by the main agent and its
# sub-agents. Defaults 120 / 600000 (10 min); exhaustion ends the turn with a
# terminal error frame. Model tokens are accounted and logged per turn, never
# limited.
# TURN_MAX_TOOL_CALLS=120
# TURN_TIMEOUT_MS=600000
# Repetition guard: identical successful calls (same tool, same arguments) one
# turn may make — a write (default 1) and a read or repeatable UI step (5).
# TURN_MAX_IDENTICAL_WRITES=1
# TURN_MAX_IDENTICAL_READS=5

# --- tracing (optional, off by default) --------------------------------------
# Trace turns to LangSmith, to IXO Traces, or to both at once (each turn is
# then sent to both). Setup, cost and checks:
# packages/oracle-runtime-workers/docs/tracing.md
#
# LangSmith: the key turns it on; TRACING=true traces every turn, or list the
# DIDs to trace in LANGSMITH_TRACED_DIDS (`*` = everyone). EU accounts set
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com.
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=my-oracle-devnet
# LANGSMITH_TRACED_DIDS=did:ixo:ixo1...,did:ixo:ixo1...
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
#
# IXO Traces (runtime 0.63.0 or later recommended): one finished turn per
# request, sent after the reply. On exactly when the write key and a
# destination are set. On IXO's Cloudflare account prefer the `TRACES`
# service binding (see wrangler.jsonc) over the endpoint; with both, the
# binding is used. For your own instance, use its URL or Worker name.
# It traces the same users as LangSmith (LANGSMITH_TRACING=true = everyone,
# else the LANGSMITH_TRACED_DIDS list; neither set = everyone), unless
# TRACES_TRACED_DIDS is set: `*` = everyone, or a comma-separated DID list
# (runtime 0.64.0 or later).
# TRACES_API_KEY=ixt_w_...
# TRACES_ENDPOINT=https://traces.ixo.earth
# TRACES_TRACED_DIDS=*
