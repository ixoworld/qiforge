# Copy to .dev.vars for `wrangler dev`. Everything here is a secret or
# environment-specific; non-secret defaults live in wrangler.jsonc `vars`.

# --- identity ---------------------------------------------------------------
ORACLE_DID=did:ixo:ixo1oracleexample
ORACLE_ENTITY_DID=did:ixo:entity:oracleexample
# Ed25519 mnemonic the oracle signs downstream UCAN invocations with (optional:
# when unset it is read from the Matrix account room the way the Node runtime
# stores it — needs MATRIX_ACCOUNT_ROOM_ID + MATRIX_VALUE_PIN below)
# ORACLE_SIGNING_MNEMONIC=

# --- auth: did:ixo key resolution ------------------------------------------
BLOCKSYNC_GRAPHQL_URL=http://localhost:34582/graphql

# --- matrix -----------------------------------------------------------------
MATRIX_BASE_URL=http://localhost:34008
MATRIX_HOMESERVER_NAME=ixo.test
MATRIX_ORACLE_ADMIN_USER_ID=@oracle-example:ixo.test
# The bot's password: the gateway logs its own devices in with it (no access token).
MATRIX_ORACLE_ADMIN_PASSWORD=
# MATRIX_RECOVERY_PHRASE=

# --- llm --------------------------------------------------------------------
OPEN_ROUTER_API_KEY=
# DEFAULT_MODEL=openai/gpt-5.6-luna
# LangGraph steps a single turn may take before GraphRecursionError (default
# 600, three times the Node runtime's 200; a tool-call round trip costs ~6
# steps with the bundled middlewares, so 600 is roughly 100 chained tool calls)
# TURN_RECURSION_LIMIT=600
# Bounded semantic Decisions (unset = off). openrouter-jev reuses OPEN_ROUTER_API_KEY;
# cloudflare-jev uses the AI binding from wrangler.jsonc instead of account credentials.
# DECISION_PROVIDER=openrouter-jev
# DECISION_MODEL=typesafe/jev-1.13
# Turn budget (docs/plans/workers-harness-hardening.md): cumulative model
# tokens, tool attempts and the wall-clock deadline of one turn, shared by the
# main agent, its sub-agents and the helper models. Defaults 500000 / 120 /
# 600000 (10 min); exhaustion ends the turn with a terminal error frame.
# TURN_MAX_TOKENS=500000
# TURN_MAX_TOOL_CALLS=120
# TURN_TIMEOUT_MS=600000
