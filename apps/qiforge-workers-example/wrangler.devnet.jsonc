{
  // Mike's devnet oracle ("Mike Matrix Test") on Cloudflare Workers — the
  // HTTP shell + per-user objects. The Matrix gateway object runs in its own
  // script (wrangler.gateway.devnet.jsonc); deploy that one first.
  // Deploy: pnpm exec wrangler deploy -c wrangler.devnet.jsonc
  // Secrets (not here): OPEN_ROUTER_API_KEY, MATRIX_ORACLE_ADMIN_PASSWORD,
  // MATRIX_RECOVERY_PHRASE, MATRIX_VALUE_PIN, ORACLE_SIGNING_MNEMONIC — via
  // `wrangler secret bulk -c wrangler.devnet.jsonc`.
  // Optional: SLACK_ALERT_WEBHOOK_URL — Slack ops alerts when a user's file
  // crosses each GB watermark (1 GB+) toward the 10 GB DO storage cap.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mike-devnet-oracle",
  // Shaun's account — where all ixo Cloudflare workers are deployed.
  "account_id": "ebfd8f0f0c0c84d40756de873c169c40",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Long user-object work (imports, VACUUM of a large file) can exceed the
  // default 30 s DO CPU cap; give it headroom.
  "limits": { "cpu_ms": 300000 },
  "alias": {
    "@matrix-org/matrix-sdk-crypto-wasm": "@ixo/matrix-bot-workers-sdk/crypto-wasm-shim",
    "jsdom": "../../packages/oracle-runtime-workers/src/plugins/editor/jsdom-shim.ts",
  },
  // The gateway keep-alive cron lives in the gateway script.
  "triggers": { "crons": [] },
  // Per-user-DID rate limit (see wrangler.jsonc for rationale).
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_ORACLE", "class_name": "UserOracleDO" },
      // Cross-script: the class lives in mike-devnet-oracle-gateway (its `v1`
      // migration transferred the namespace out of this script).
      {
        "name": "MATRIX_GATEWAY",
        "class_name": "MatrixGatewayDO",
        "script_name": "mike-devnet-oracle-gateway",
      },
    ],
  },
  "migrations": [
    // History: MatrixGatewayDO was created here and later transferred to the
    // gateway script (see wrangler.gateway.devnet.jsonc).
    { "tag": "v1", "new_sqlite_classes": ["UserOracleDO", "MatrixGatewayDO"] },
  ],
  "vars": {
    "ORACLE_NAME": "Mike Matrix Test",
    "NETWORK": "devnet",
    "ORACLE_DID": "did:ixo:ixo1seyngesnj6673qqzf0um4e6c2rutfsrafc9tw3",
    "ORACLE_ENTITY_DID": "did:ixo:entity:309db22aa6e41e3929597dcb185a23be",
    "BLOCKSYNC_GRAPHQL_URL": "https://devnet-blocksync-graphql.ixo.earth/graphql",
    "MATRIX_BASE_URL": "https://mx.mike-test.ixo.world",
    "MATRIX_HOMESERVER_NAME": "mx.mike-test.ixo.world",
    "MATRIX_ORACLE_ADMIN_USER_ID": "@did-ixo-ixo1seyngesnj6673qqzf0um4e6c2rutfsrafc9tw3:mx.mike-test.ixo.world",
    "MATRIX_ACCOUNT_ROOM_ID": "!CIaEYbuVpDDuIRZdGX:mx.mike-test.ixo.world",
    // OWNER_STORE deliberately unset: IXO VFS is the system of record, Matrix
    // room media is read once as legacy and migrated in. Explicit URLs also
    // activate the vfs plugin (user file tools).
    "VFS_BASE_URL": "https://devnet.vfs.ixo.earth",
    "UCAN_STORE_URL": "https://devnet.store.ucan.ixo.earth",
    "MEMORY_MCP_URL": "https://mcp-memory-engine.devnet.ixo.earth/mcp",
    "MEMORY_ENGINE_URL": "https://memory-engine.devnet.ixo.earth",
    "FIRECRAWL_MCP_URL": "https://mcp-firecrawl.ixo.earth/v2/mcp",
    "DOMAIN_INDEXER_URL": "https://domain-indexer.devnet.ixo.earth",
    "SANDBOX_MCP_URL": "https://ai-sandbox-devnet.ixo.earth/mcp",
    "SKILLS_CAPSULES_BASE_URL": "https://capsules.skills.ixo.earth",
    "BYO_LLM_ENABLED": "true",
    // ChatGPT-subscription lane: model requests go through the ixo-proxy-app
    // instance on the Vultr host (chatgpt.com blocks Cloudflare egress). The
    // proxy is open (no gate token).
    "BYO_CHATGPT_BACKEND_URL": "https://chatgpt.proxy.ixo.earth",
    "LOG_LEVEL": "info",
    // Auth-gated operator routes (/debug/storage, /debug/tasks, ...) — handy
    // while testing devnet; drop for a production oracle.
    "ORACLE_DEBUG_ROUTES": "true",
    // Optional: per-user-object clean-chunk cache (default 4 MiB; 8 MiB was
    // measured indistinguishable on devnet — see docs/operations.md).
    // "CHUNK_CACHE_BYTES": "8m",
  },
}
