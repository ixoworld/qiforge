{
  "name": "qiforge-example",
  "version": "0.0.1",
  "description": "Reference oracle that boots the QiForge runtime with all bundled plugins.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:integration": "vitest run --mode int",
    "test": "vitest run"
  },
  "dependencies": {
    "@ixo/oracle-runtime": "workspace:*",
    "@nestjs/common": "^11.1.19",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.1",
    "langchain": "1.4.2",
    "matrix-js-sdk": "^37.11.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@bull-board/api": "^7.2.1",
    "@bull-board/express": "^7.2.1",
    "@bull-board/nestjs": "^7.2.1",
    "@ixo/vitest-config": "workspace:*",
    "@langchain/core": "1.1.48",
    "@nestjs/bullmq": "^11.0.4",
    "@types/node": "^22.10.7",
    "bullmq": "^5.78.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@digitalbazaar/http-client": "4.2.0"
  }
}
