{
  "name": "ixo-transaction-message-catalog",
  "version": "0.1.0",
  "commandFormat": "/ixo {message-type} {message-action}",
  "queryOnlyModules": ["epochs", "mint"],
  "modules": {
    "entity": [
      "create",
      "update",
      "update-verified",
      "transfer",
      "create-account",
      "grant-account-authz",
      "revoke-account-authz"
    ],
    "iid": [
      "create",
      "update",
      "add-verification",
      "revoke-verification",
      "set-verification-relationships",
      "add-service",
      "delete-service",
      "add-controller",
      "delete-controller",
      "add-linked-resource",
      "delete-linked-resource",
      "add-linked-claim",
      "delete-linked-claim",
      "add-linked-entity",
      "delete-linked-entity",
      "add-accorded-right",
      "delete-accorded-right",
      "add-context",
      "delete-context",
      "deactivate"
    ],
    "claims": [
      "create-collection",
      "submit",
      "evaluate",
      "dispute",
      "withdraw-payment",
      "update-collection-state",
      "update-collection-dates",
      "update-collection-payments",
      "update-collection-intents",
      "update-collection-quota",
      "claim-intent",
      "create-claim-authorization",
      "set-collection-members",
      "remove-collection-members",
      "update-collection-dispute-config",
      "add-performance-deposit",
      "withdraw-performance-deposit",
      "adjudicate-dispute"
    ],
    "token": [
      "create",
      "mint",
      "transfer",
      "retire",
      "transfer-credit",
      "cancel",
      "pause",
      "stop"
    ],
    "bonds": [
      "create",
      "edit",
      "set-next-alpha",
      "update-state",
      "buy",
      "sell",
      "swap",
      "make-outcome-payment",
      "withdraw-share",
      "withdraw-reserve"
    ],
    "liquidstake": [
      "stake",
      "unstake",
      "redeem",
      "claim",
      "create-validator",
      "add-validator",
      "remove-validator",
      "update-validator",
      "update-params",
      "set-module-paused"
    ],
    "names": [
      "create-namespace",
      "update-namespace",
      "register",
      "register-by-registrar",
      "update-by-registrar",
      "transfer",
      "set-status"
    ],
    "smart-account": [
      "add-authenticator",
      "remove-authenticator",
      "set-active-state"
    ]
  },
  "coreOutput": {
    "action": "sign_transaction",
    "network": "testnet",
    "messages": [
      { "typeUrl": "/ixo.entity.v1beta1.MsgCreateEntity", "value": {} }
    ],
    "memo": "optional memo",
    "riskLevel": "high",
    "riskConfirmation": {
      "confirmed": true,
      "acceptedRisks": ["Human-readable risk accepted by the user"]
    }
  }
}
