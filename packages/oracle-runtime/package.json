{
  "name": "@ixo/oracle-runtime",
  "version": "0.0.1",
  "description": "Plugin-based runtime for QiForge oracles",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@ixo/eslint-config": "workspace:*",
    "@ixo/typescript-config": "workspace:*",
    "@ixo/vitest-config": "workspace:*",
    "@nestjs/testing": "^11.1.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.4",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@composio/core": "^0.8.0",
    "@composio/langchain": "^0.8.0",
    "@ixo/common": "workspace:*",
    "@ixo/matrix": "1.2.3",
    "@ixo/oracles-chain-client": "1.2.1",
    "@ixo/oracles-events": "1.0.4",
    "@ixo/sqlite-saver": "^1.0.52",
    "@ixo/ucan": "1.2.2",
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "better-sqlite3": "^12.9.0",
    "cache-manager": "^7.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.10.1",
    "js-tiktoken": "^1.0.21",
    "langchain": "^1.4.0",
    "minisearch": "^7.2.0",
    "node-emoji": "^2.2.0",
    "socket.io": "4.8.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
