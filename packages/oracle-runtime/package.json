{
  "name": "@ixo/oracle-runtime",
  "version": "1.0.32",
  "description": "Plugin-based runtime for QiForge oracles",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ixoworld/qiforge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --mode int",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./testing/integration": {
      "types": "./dist/testing/integration/index.d.ts",
      "import": "./dist/testing/integration/index.js",
      "default": "./dist/testing/integration/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@ixo/eslint-config": "workspace:*",
    "@ixo/typescript-config": "workspace:*",
    "@ixo/vitest-config": "workspace:*",
    "@nestjs/testing": "^11.1.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@blocknote/server-util": "0.29.1",
    "@composio/core": "0.10.0",
    "@composio/langchain": "0.9.2",
    "@ixo/common": "workspace:*",
    "@ixo/editor": "3.0.0-beta.11",
    "@ixo/matrix": "workspace:*",
    "@ixo/matrix-crdt": "^1.2.5",
    "@ixo/oracles-chain-client": "workspace:*",
    "@ixo/oracles-events": "workspace:*",
    "@ixo/slack": "1.0.0",
    "@ixo/sqlite-saver": "workspace:*",
    "@ixo/ucan": "workspace:*",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.3.2",
    "@langchain/mcp-adapters": "1.1.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.76.2",
    "cache-manager": "^7.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron-parser": "^5.5.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.10.1",
    "js-tiktoken": "^1.0.21",
    "langchain": "1.4.2",
    "matrix-js-sdk": "^37.11.0",
    "node-emoji": "^2.2.0",
    "socket.io": "4.8.3",
    "yjs": "^13.6.27",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
