{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "oracle-runtime-workers-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  // The crypto crate's stock entrypoints can't load on workerd (runtime wasm
  // compilation is disallowed). Alias to the bot SDK's loader, which imports
  // the .wasm as a build-time CompiledWasm module; matrix-js-sdk resolves
  // through it too.
  "alias": {
    "@matrix-org/matrix-sdk-crypto-wasm": "@ixo/matrix-bot-workers-sdk/crypto-wasm-shim",
    // Real jsdom can't load on workerd (needs node:vm script contexts).
    // @blocknote/server-util only uses it for a window/document pair, so the
    // editor plugin substitutes a linkedom-backed shim.
    "jsdom": "../src/plugins/editor/jsdom-shim.ts",
  },
  // Local (miniflare) R2 buckets for the page-tier and artefact tests.
  // The worker bound to itself: tests reach the stub routes of `worker.ts`
  // through workerd's real `fetch` (see `domainContextStub`).
  "services": [
    { "binding": "LOOPBACK", "service": "oracle-runtime-workers-test" },
  ],
  "r2_buckets": [
    { "binding": "TIER_TEST", "bucket_name": "tier-test" },
    { "binding": "ARTIFACT_TEST", "bucket_name": "artifact-test" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACTION_PROPOSAL_TEST", "class_name": "ActionProposalTestDO" },
      { "name": "HUB_ACTION_TEST", "class_name": "HubActionTestDO" },
      { "name": "CHANNEL_TURNS_TEST", "class_name": "ChannelTurnsTestDO" },
      { "name": "SQLITE_TEST", "class_name": "SqliteTestDO" },
      { "name": "TASKS_TEST", "class_name": "TasksTestDO" },
      { "name": "REALTIME_TEST", "class_name": "RealtimeTestDO" },
      { "name": "RUN_STORE_TEST", "class_name": "RunStoreTestDO" },
      { "name": "RESULT_STORE_TEST", "class_name": "ResultStoreTestDO" },
      { "name": "ARTIFACT_STORE_TEST", "class_name": "ArtifactStoreTestDO" },
      { "name": "FEEDBACK_TEST", "class_name": "FeedbackTestDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SqliteTestDO", "TasksTestDO", "RealtimeTestDO"],
    },
    { "tag": "v2", "new_sqlite_classes": ["RunStoreTestDO"] },
    { "tag": "v3", "new_sqlite_classes": ["ResultStoreTestDO"] },
    { "tag": "v4", "new_sqlite_classes": ["ChannelTurnsTestDO"] },
    { "tag": "v5", "new_sqlite_classes": ["ArtifactStoreTestDO"] },
    { "tag": "v7", "new_sqlite_classes": ["ActionProposalTestDO"] },
    { "tag": "v6", "new_sqlite_classes": ["FeedbackTestDO"] },
    { "tag": "v8", "new_sqlite_classes": ["HubActionTestDO"] },
  ],
}
