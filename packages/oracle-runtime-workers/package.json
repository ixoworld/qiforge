{
  "name": "@ixo/oracle-runtime-workers",
  "version": "0.8.0",
  "description": "QiForge oracle runtime for Cloudflare Workers — Durable Object per user (SQLite in WASM over DO storage), Matrix E2EE gateway Durable Object, Hono HTTP/SSE shell.",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ixoworld/qiforge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run --config vitest.core.config.ts",
    "lint": "eslint 'src/**/*.ts'"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./gateway": "./src/gateway-worker.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__/",
    "!src/**/fixtures/",
    "!src/**/test-do.ts",
    "!src/core/test-fixtures.ts"
  ],
  "dependencies": {
    "@blocknote/server-util": "0.29.1",
    "@composio/core": "0.10.0",
    "@composio/langchain": "0.9.2",
    "@ixo/editor": "6.0.1",
    "@ixo/matrix-bot-workers-sdk": "0.4.0",
    "@ixo/matrix-crdt": "^1.2.5",
    "@ixo/ucan": "workspace:*",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.3.2",
    "@langchain/langgraph-checkpoint": "1.0.2",
    "@langchain/mcp-adapters": "1.1.3",
    "@langchain/openai": "1.4.7",
    "@noble/hashes": "^1.8.0",
    "cron-parser": "^5.5.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.4",
    "jose": "^6.0.0",
    "langchain": "1.4.2",
    "langsmith": "^0.5.26",
    "linkedom": "^0.18.12",
    "marked": "^16.4.0",
    "matrix-js-sdk": "^42.2.0",
    "superjson": "1.13.3",
    "wa-sqlite": "1.0.0",
    "yjs": "13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@ixo/typescript-config": "workspace:*",
    "happy-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.125.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
