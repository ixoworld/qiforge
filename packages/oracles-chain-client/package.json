{
  "name": "@ixo/oracles-chain-client",
  "version": "1.3.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ixoworld/qiforge.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/client-public.d.ts",
      "import": "./dist/client/client-public.js",
      "require": "./dist/client/client-public.js",
      "default": "./dist/client/client-public.js"
    },
    "./claims": {
      "types": "./dist/client/claims/index.d.ts",
      "import": "./dist/client/claims/index.js",
      "require": "./dist/client/claims/index.js",
      "default": "./dist/client/claims/index.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js",
      "require": "./dist/credentials.js",
      "default": "./dist/credentials.js"
    },
    "./payments": {
      "types": "./dist/client/payments/index.d.ts",
      "import": "./dist/client/payments/index.js",
      "require": "./dist/client/payments/index.js",
      "default": "./dist/client/payments/index.js"
    },
    "./authz": {
      "types": "./dist/client/authz/index.d.ts",
      "import": "./dist/client/authz/index.js",
      "require": "./dist/client/authz/index.js",
      "default": "./dist/client/authz/index.js"
    },
    "./entities": {
      "types": "./dist/client/entities/index.d.ts",
      "import": "./dist/client/entities/index.js",
      "require": "./dist/client/entities/index.js",
      "default": "./dist/client/entities/index.js"
    },
    "./gql": {
      "types": "./dist/gql/index.d.ts",
      "import": "./dist/gql/index.js",
      "require": "./dist/gql/index.js",
      "default": "./dist/gql/index.js"
    },
    "./matrix-bot": {
      "types": "./dist/matrix-bot/index.d.ts",
      "import": "./dist/matrix-bot/index.js",
      "require": "./dist/matrix-bot/index.js",
      "default": "./dist/matrix-bot/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc && tsc-alias",
    "generate": "graphql-codegen --config codegen.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/client-preset": "^4.7.0",
    "@graphql-codegen/typescript": "^4.1.5",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^4.5.1",
    "@ixo/eslint-config": "workspace:*",
    "@ixo/typescript-config": "workspace:*",
    "@ixo/vitest-config": "workspace:*",
    "@types/node": "22.10.0",
    "@types/store": "2.0.5",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.11",
    "tsconfig-paths": "^4.2.0",
    "tsup": "8.3.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@cosmjs/crypto": "0.32.4",
    "@cosmjs/encoding": "0.32.4",
    "@cosmjs/proto-signing": "0.32.4",
    "@cosmjs/stargate": "0.32.4",
    "@ixo/did-provider-x": "^0.0.2",
    "@ixo/impactxclient-sdk": "2.4.1",
    "@ixo/logger": "workspace:*",
    "@ixo/matrixclient-sdk": "^1.0.0",
    "@veramo/core": "^7.0.0",
    "@veramo/credential-ld": "^7.0.0",
    "@veramo/credential-w3c": "^7.0.0",
    "@veramo/did-manager": "^7.0.0",
    "@veramo/did-provider-key": "^7.0.0",
    "@veramo/did-resolver": "^7.0.0",
    "@veramo/key-manager": "^7.0.0",
    "@veramo/kms-local": "^7.0.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axios": "1.7.8",
    "axios-retry": "4.5.0",
    "bs58": "^6.0.0",
    "did-resolver": "4.1.0",
    "dotenv": "^17.2.3",
    "eciesjs": "^0.4.15",
    "graphql": "^16.10.0",
    "graphql-request": "7.1.2",
    "graphql-tag": "^2.12.6",
    "limiter": "2.1.0",
    "store": "2.0.12",
    "jose": "^6.0.8",
    "zod": "^4.3.6"
  }
}
