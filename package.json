{
  "name": "my-turborepo",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo dev --filter=app",
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "lint": "eslint packages && eslint apps/qiforge-example",
    "lint:fix": "eslint packages --fix && eslint apps/qiforge-example --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "version": "changeset version",
    "release": "changeset tag",
    "deploy": "./scripts/deploy.sh",
    "infra:up": "docker compose up -d redis redis-insight",
    "infra:down": "docker compose down",
    "infra:clean": "docker compose down -v"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.18.0",
    "@ixo/eslint-config": "2.0.0",
    "@ixo/typescript-config": "1.0.0",
    "@vitest/eslint-plugin": "^1.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-config-turbo": "^2.6.0",
    "prettier": "^3.6.2",
    "tsc": "^2.0.4",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "react-jazzicon",
        "@mantine/core",
        "@mantine/hooks",
        "@blocknote/core",
        "@blocknote/react",
        "@blocknote/mantine",
        "@ixo/surveys"
      ]
    },
    "overrides": {
      "ws": "8.18.2",
      "@langchain/core": "1.1.48",
      "@langchain/langgraph": "1.3.2",
      "@langchain/langgraph-checkpoint": "1.0.2",
      "@langchain/langgraph-checkpoint-sqlite": "1.0.1",
      "@langchain/langgraph-checkpoint-validation": "1.0.9",
      "@langchain/langgraph-supervisor": "1.0.3",
      "@langchain/community": "1.1.28",
      "@langchain/openai": "1.4.7",
      "@langchain/textsplitters": "1.0.1",
      "@langchain/mcp-adapters": "1.1.3",
      "langchain": "1.4.2",
      "@composio/core": "0.10.0",
      "@composio/langchain": "0.9.2",
      "@digitalbazaar/http-client": "4.2.0",
      "@ixo/matrix": "1.2.33"
    },
    "onlyBuiltDependencies": [
      "@ixo/matrix-sdk-crypto-nodejs",
      "@matrix-org/matrix-sdk-crypto-nodejs",
      "@nestjs/core",
      "@scarf/scarf",
      "@swc/core",
      "@veramo/credential-ld",
      "better-sqlite3",
      "cpu-features",
      "esbuild",
      "maplibre-gl",
      "msgpackr-extract",
      "protobufjs",
      "secp256k1",
      "sharp",
      "ssh2",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "@veramo/credential-ld@6.0.0": "patches/@veramo__credential-ld@6.0.0.patch"
    }
  }
}
