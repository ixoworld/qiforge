{
  "name": "my-turborepo",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo dev --filter=app",
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "lint": "eslint packages && eslint apps/qiforge-example",
    "lint:fix": "eslint packages --fix && eslint apps/qiforge-example --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "version": "changeset version",
    "release": "changeset tag",
    "deploy": "./scripts/deploy.sh",
    "infra:up": "docker compose up -d redis redis-insight",
    "infra:down": "docker compose down",
    "infra:clean": "docker compose down -v"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.18.0",
    "@ixo/eslint-config": "2.0.0",
    "@ixo/typescript-config": "1.0.0",
    "@vitest/eslint-plugin": "^1.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-config-turbo": "^2.6.0",
    "prettier": "^3.6.2",
    "tsc": "^2.0.4",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ixoworld/qiforge.git"
  }
}
